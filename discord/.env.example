# Read by `npm run register` (registers the /verify slash command).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# The role grant and the interactions endpoint run in tacit-api (worker/src/index.js), which reads:
#   DISCORD_PUBLIC_KEY   the application's public key (Developer Portal > General Information)
#   DISCORD_BOT_TOKEN    the same value as DISCORD_TOKEN above
#   TAC_ROLE_ID          the role granted to a verified holder
#   DAPP_URL             optional, defaults to https://tacit.finance
# The application's Interactions Endpoint URL is https://api.tacit.finance/discord/interaction
